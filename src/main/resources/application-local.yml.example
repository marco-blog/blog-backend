# 로컬 개발용 설정 예시(개발 DB cf_u2_d2).
# 이 파일을 application-local.yml 로 복사해 비밀번호를 채운다. application-local.yml 은 커밋하지 않는다(.gitignore).
# 비밀번호는 Crowfoot 화면의 "데이터베이스" 탭에서 확인한다.
# 실행: ./mvnw spring-boot:run   (프로필을 지정하지 않으면 local)
spring:
  datasource:
    url: jdbc:mysql://s4.java21.net:13306/cf_u2_d2?connectionTimeZone=UTC&characterEncoding=UTF-8
    username: cf_u2_d2
    password: <password>
  jpa:
    show-sql: true

logging:
  level:
    net.java21.blog: DEBUG
