# 로컬 비밀 값 예시. 이 파일을 .env 로 복사해 값을 채운다. .env 는 커밋하지 않는다(.gitignore).
# DB 비밀번호는 Crowfoot 화면의 "데이터베이스" 탭에서 확인한다(개발 DB cf_u2_d2).
DB_PASSWORD=

# 개인정보 암호화 키(Base64 32바이트). 각각 따로 생성: openssl rand -base64 32
# 해시 키는 한번 정하면 바꾸지 않는다(바꾸면 email_hash 전체를 다시 계산해야 한다).
BLOG_CRYPTO_KEY_V1=
BLOG_CRYPTO_HASH_KEY=

# 접근 토큰(JWT HS256) 서명 키. UTF-8 32바이트 이상 무작위 문자열: openssl rand -base64 48
BLOG_AUTH_JWT_SECRET=

# (선택) 약관·개인정보처리방침 버전. 비우면 application.yml 기본값을 쓴다. 비밀 값이 아니다.
# BLOG_LEGAL_TERMS_VERSION=

# (선택) 메일. 비우면 application-local.yml 기본값(Mailpit localhost:1025, 인증 없음)을 쓴다.
# BLOG_MAIL_HOST=
# BLOG_MAIL_PORT=
# BLOG_MAIL_USERNAME=
# BLOG_MAIL_PASSWORD=
# BLOG_MAIL_FROM=
# (선택) 첫 최고 관리자(SUPER_ADMIN)로 지정할 회원 이메일. SUPER_ADMIN이 한 명도 없을 때 기동 시 한 번 적용된다(006 FR-105).
# BLOG_ADMIN_BOOTSTRAP_SUPER_ADMIN_EMAIL=
